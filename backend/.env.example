# Copy to backend/.env and fill in real values. Never commit .env.

# --- Server ---
PORT=5001
NODE_ENV=development
# Public URLs (no trailing slash). CLIENT_URL is used for CORS and OAuth redirects.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001
# Set to the number of reverse proxies in front of the server (e.g. 1) so rate limiting sees real client IPs
# TRUST_PROXY=1

# --- Database (PostgreSQL) ---
# Local docker-compose: postgres://postgres:postgres@db:5432/drawing_app
# Neon / hosted:        postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/drawing_app
# SSL is automatic: on (with certificate verification) for remote hosts, off for localhost/db.
# DATABASE_SSL=true|false          # force on/off
# DATABASE_SSL_INSECURE=true       # skip certificate verification (not recommended)

# --- Auth ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- OAuth (optional; a provider is disabled if its pair is missing) ---
# Callback URLs to register: ${SERVER_URL}/auth/google/callback and ${SERVER_URL}/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
